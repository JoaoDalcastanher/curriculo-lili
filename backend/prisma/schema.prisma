generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// EXAMPLE MODEL — delete this when implementing real features.
// Replace with your actual domain models.
model Example {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  @@map("examples")
}
