{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API — Bun + tRPC + Prisma",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./trpc": "./src/trpc.ts"
  },
  "scripts": {
    "dev": "bun --hot --env-file=../.env src/index.ts",
    "start": "bun --env-file=../.env src/index.ts",
    "build": "tsc",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "@trpc/server": "11.11.0",
    "redis": "5.11.0",
    "superjson": "2.2.6",
    "winston": "3.19.0",
    "winston-transport": "4.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "20.19.35",
    "prisma": "6.16.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
