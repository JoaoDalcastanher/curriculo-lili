{
  "name": "base-template",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "bun": ">=1.2.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "bunx concurrently \"bun run --filter backend dev\" \"bun run --filter frontend dev\"",
    "dev:backend": "bun run --filter backend dev",
    "dev:frontend": "bun run --filter frontend dev",
    "build:frontend": "bun run --filter frontend build",
    "start:frontend": "bun run --filter frontend start",
    "build:backend": "bun run --filter backend build",
    "start:backend": "bun run --filter backend start",
    "lint": "eslint \"backend/src/**/*.ts\" \"frontend/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"backend/src/**/*.ts\" \"frontend/src/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "concurrently": "8.2.2",
    "eslint": "9.20.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "prettier": "3.4.2",
    "typescript-eslint": "8.24.0"
  }
}
