# ─── Database ────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/myapp

# ─── Session ─────────────────────────────────────────────────────────────────
# Random string of at least 32 characters. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=REQUIRED
# Set in production only. Example: .myapp.com
SESSION_COOKIE_DOMAIN=

# ─── Redis ───────────────────────────────────────────────────────────────────
# Used for session storage in production. In-memory store is used in development.
REDIS_URL=redis://localhost:6379

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (production).
# Dev defaults (localhost:3000, localhost:3002) are used when this is unset.
ALLOWED_ORIGINS=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Rate limiting: maximum requests per IP per minute.
RATE_LIMIT_MAX_REQUESTS=60

# ─── Timezone ────────────────────────────────────────────────────────────────
# IANA timezone identifier. Defaults to UTC if unset.
# Example: America/Sao_Paulo, Europe/London, Asia/Tokyo
APP_TIMEZONE=UTC

# ─── External HTTP client + structured logging ───────────────────────────────
# Applies to every outbound call made through backend/src/utils/httpClient.ts.
# See ADR-0013. Each retry attempt is logged (credential-redacted) to external.log.
# Max retries after the first attempt.
EXTERNAL_HTTP_MAX_RETRIES=3
# Base backoff delay in ms (exponential: base, 2×base, 4×base, ...).
EXTERNAL_HTTP_RETRY_BASE_MS=200
# Per-attempt request timeout in ms.
EXTERNAL_HTTP_TIMEOUT_MS=10000
# external.log auto-truncates once it passes this size (MB), keeping the last 80%.
EXTERNAL_LOG_MAX_SIZE_MB=15
# Log directory, relative to the backend working directory (resolves to backend/logs).
EXTERNAL_LOG_DIR=logs

# ─── Feature flags ───────────────────────────────────────────────────────────
# Set to "true" to enable. See backend/src/config/features.ts.
FEATURE_NEW_DASHBOARD=false

# ─── Frontend ────────────────────────────────────────────────────────────────
# Backend API URL as seen from the browser. Leave empty to use relative /api.
VITE_API_URL=
